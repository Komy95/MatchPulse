# App
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase public client config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Cloud / Firebase server config
GOOGLE_CLOUD_PROJECT=
FIREBASE_PROJECT_ID=

# Optional local Firebase Admin SDK service account values.
# Prefer Application Default Credentials in deployed Cloud Run.
FIREBASE_SERVICE_ACCOUNT_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_CLIENT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Local emulator host values. Do not set these in production.
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# OpenAI
OPENAI_API_KEY=
OPENAI_INSIGHT_MODEL=

# Sports provider
SPORTS_PROVIDER=mock
SPORTS_PROVIDER_API_KEY=

# Security
CRON_SECRET=

# Simulation
SIM_DEFAULT_RUNS=10000
PUBLIC_SIM_RUNS=100000

# Caching
LIVE_CACHE_TTL_SEC=15
INSIGHT_CACHE_TTL_SEC=3600
PUBLIC_SIM_CACHE_TTL_SEC=86400

# Ads and consent
AD_PROVIDER=adsense
CONSENT_MODE=strict
