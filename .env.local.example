# Copy this file to .env.local for local development.
# Do not commit real secrets.

APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-matchpulse.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=matchpulse-local
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=matchpulse-local.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true

GOOGLE_CLOUD_PROJECT=matchpulse-local
FIREBASE_PROJECT_ID=matchpulse-local
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

OPENAI_API_KEY=
OPENAI_INSIGHT_MODEL=

SPORTS_PROVIDER=mock
SPORTS_PROVIDER_API_KEY=

CRON_SECRET=

SIM_DEFAULT_RUNS=10000
PUBLIC_SIM_RUNS=100000

LIVE_CACHE_TTL_SEC=15
INSIGHT_CACHE_TTL_SEC=3600
PUBLIC_SIM_CACHE_TTL_SEC=86400

AD_PROVIDER=adsense
CONSENT_MODE=strict
