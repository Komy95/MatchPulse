{
  "name": "matchpulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test scripts/form-field-styles.test.mjs scripts/invite-join.test.mjs scripts/sports-data.test.mjs scripts/predictions.test.mjs scripts/scoring.test.mjs scripts/leaderboard.test.mjs scripts/dashboard.test.mjs scripts/world-cup-reference.test.mjs",
    "test:emulator": "firebase emulators:exec --only auth,firestore \"node --test --test-concurrency=1 scripts/predictions-emulator.test.mjs scripts/dashboard-emulator.test.mjs\"",
    "validate:foundation": "node scripts/validate-foundation.mjs",
    "seed:reference": "node scripts/seed-world-cup-reference-data.mjs",
    "emulators": "firebase emulators:start --only auth,firestore"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "firebase-admin": "^13.4.0",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^22.13.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.0",
    "firebase-tools": "^14.9.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
