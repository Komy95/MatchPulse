rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isActiveGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == "ACTIVE";
    }

    function userProfileFields() {
      return [
        "displayName",
        "email",
        "photoUrl",
        "locale",
        "countryCode",
        "favoriteTeamIds",
        "followedTeamIds",
        "globalLeaderboardOptIn",
        "consent",
        "createdAt",
        "updatedAt"
      ];
    }

    function userPreferenceFields() {
      return [
        "locale",
        "countryCode",
        "favoriteTeamIds",
        "followedTeamIds",
        "globalLeaderboardOptIn",
        "consent",
        "updatedAt"
      ];
    }

    function nullableString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function validConsent(consent) {
      return consent is map
        && consent.keys().hasOnly(["termsAccepted", "privacyAccepted", "marketing"])
        && consent.termsAccepted is bool
        && consent.privacyAccepted is bool
        && consent.marketing is bool;
    }

    function validUserProfile(data) {
      return data.keys().hasAll(userProfileFields())
        && data.keys().hasOnly(userProfileFields())
        && nullableString(data.displayName, 120)
        && nullableString(data.email, 320)
        && nullableString(data.photoUrl, 2048)
        && data.locale is string
        && data.locale.size() >= 2
        && data.locale.size() <= 35
        && nullableString(data.countryCode, 2)
        && data.favoriteTeamIds is list
        && data.favoriteTeamIds.size() <= 64
        && data.followedTeamIds is list
        && data.followedTeamIds.size() <= 128
        && data.globalLeaderboardOptIn is bool
        && validConsent(data.consent);
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId)
        && validUserProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isSelf(userId)
        && validUserProfile(request.resource.data)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(userPreferenceFields())
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.email == resource.data.email
        && request.resource.data.photoUrl == resource.data.photoUrl
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /competitions/{competitionId} {
      allow read: if true;
      allow write: if false;

      match /seasons/{seasonId} {
        allow read: if true;
        allow write: if false;

        match /tournamentGroups/{tournamentGroupId} {
          allow read: if true;
          allow write: if false;
        }

        match /teams/{teamId} {
          allow read: if true;
          allow write: if false;
        }

        match /players/{playerId} {
          allow read: if true;
          allow write: if false;
        }

        match /squads/{squadId} {
          allow read: if true;
          allow write: if false;
        }

        match /matches/{matchId} {
          allow read: if true;
          allow write: if false;
        }

        match /bracketNodes/{bracketNodeId} {
          allow read: if true;
          allow write: if false;
        }
      }
    }

    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    match /groups/{groupId} {
      allow read: if isActiveGroupMember(groupId);
      allow write: if false;

      match /members/{userId} {
        allow read: if isActiveGroupMember(groupId);
        allow write: if false;
      }

      match /seasons/{groupSeasonId} {
        allow read: if isActiveGroupMember(groupId);
        allow write: if false;

        match /invites/{inviteId} {
          allow read, write: if false;
        }

        match /predictions/{predictionId} {
          allow read: if isActiveGroupMember(groupId)
            && resource.data.userId == request.auth.uid;
          allow write: if false;
        }

        match /predictionRevisions/{revisionId} {
          allow read, write: if false;
        }

        match /leaderboardSnapshots/{snapshotId} {
          // Private aggregate standings only. Raw predictions stay under predictions
          // and remain readable only by their owning user.
          allow read: if isActiveGroupMember(groupId);
          allow write: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
